<?xml version="1.0"?>
<!-- Original Studio test/demo geometry, Apache-2.0. A virtual Cartesian arm, no hardware driver. -->
<robot name="Studio Cartesian Pick Arm">
 <material name="arm"><color rgba="0.2 0.7 0.65 1"/></material>
 <material name="metal"><color rgba="0.6 0.7 0.85 1"/></material>
 <link name="base_link"><visual><origin xyz="0 0 0.015"/><geometry><box size="0.5 0.5 0.03"/></geometry><material name="metal"/></visual></link>
 <link name="x_carriage"><visual><origin xyz="0 0 0.04"/><geometry><box size="0.08 0.08 0.08"/></geometry><material name="arm"/></visual></link>
 <link name="y_carriage"><visual><origin xyz="0 0 0.06"/><geometry><box size="0.05 0.05 0.12"/></geometry><material name="metal"/></visual></link>
 <link name="wrist"><visual><geometry><box size="0.08 0.06 0.04"/></geometry><material name="arm"/></visual></link>
 <link name="tool0"/>
 <link name="finger"><visual><origin xyz="0 0 -0.02"/><geometry><box size="0.012 0.04 0.04"/></geometry><material name="metal"/></visual></link>
 <joint name="axis_x" type="prismatic"><parent link="base_link"/><child link="x_carriage"/><axis xyz="1 0 0"/><limit lower="-0.2" upper="0.2" velocity="0.12" effort="10" acceleration="0.4"/></joint>
 <joint name="axis_y" type="prismatic"><parent link="x_carriage"/><child link="y_carriage"/><axis xyz="0 1 0"/><limit lower="-0.2" upper="0.2" velocity="0.12" effort="10" acceleration="0.4"/></joint>
 <joint name="axis_z" type="prismatic"><origin xyz="0 0 0.08"/><parent link="y_carriage"/><child link="wrist"/><axis xyz="0 0 1"/><limit lower="0" upper="0.3" velocity="0.10" effort="10" acceleration="0.3"/></joint>
 <joint name="tool_fixed" type="fixed"><parent link="wrist"/><child link="tool0"/><origin xyz="0 0 -0.035"/></joint>
 <joint name="finger_slide" type="prismatic"><parent link="wrist"/><child link="finger"/><origin xyz="0.01 0 0"/><axis xyz="1 0 0"/><limit lower="0" upper="0.04" velocity="0.08" effort="5" acceleration="0.4"/></joint>
</robot>
