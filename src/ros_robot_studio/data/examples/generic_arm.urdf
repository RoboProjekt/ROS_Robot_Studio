<?xml version="1.0"?>
<robot name="Atlas Research Arm">
  <link name="base_link"/>
  <link name="shoulder_link"/>
  <link name="upper_arm"/>
  <link name="forearm"/>
  <link name="tool_link"/>
  <joint name="base_rotation" type="continuous">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.16"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.12"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0.12 0 0.28"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="8" velocity="1"/>
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="forearm"/><child link="tool_link"/>
    <origin xyz="0.24 0 0.12"/>
  </joint>
</robot>
